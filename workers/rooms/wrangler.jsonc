{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mini-game-arcade-rooms",
  "main": "worker.js",
  "compatibility_date": "2026-11-23",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [{ "pattern": "rooms.hmarcade.dpdns.org", "custom_domain": true }],
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "GameRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],
  "vars": {
    "ROOM_ORIGINS": "https://qynebula.github.io,https://fingertip-game-lobby.qynebula.chatgpt.site"
  }
}
